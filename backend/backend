CREATE DATABASE zigna;
USE zigna;

-- Tabla Usuario
CREATE TABLE Usuario 
(
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nombres VARCHAR(45),
    apellido_paterno VARCHAR(45),
    apellido_materno VARCHAR(45),
    correo VARCHAR(45),
    contrasena VARCHAR(100)
);

-- Tabla Modulo
CREATE TABLE Modulo 
(
    id_Modulo INT AUTO_INCREMENT PRIMARY KEY,
    nombre_modulo VARCHAR(100),
    descripcion VARCHAR(45)
);

-- Tabla Contenido
CREATE TABLE Contenido 
(
    id_Contenido INT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(100),
    tipo VARCHAR(100),
    descripcion TEXT,
    imagen VARCHAR(45),
    id_Modulo INT,
    FOREIGN KEY (id_Modulo) REFERENCES Modulo(id_Modulo)
);

-- Tabla Evaluacion
CREATE TABLE Evaluacion 
(
    id_Evaluacion INT AUTO_INCREMENT PRIMARY KEY,
    id_Modulo INT,
    FOREIGN KEY (id_Modulo) REFERENCES Modulo(id_Modulo)
);

-- Tabla Resultado_evaluacion
CREATE TABLE Resultado_evaluacion 
(
    idResultado_evaluacion INT AUTO_INCREMENT PRIMARY KEY,
    fecha DATE,
    puntaje INT,
    id_Usuario INT,
    id_Evaluacion INT,
    FOREIGN KEY (id_Usuario) REFERENCES Usuario(id_usuario),
    FOREIGN KEY (id_Evaluacion) REFERENCES Evaluacion(id_Evaluacion)
);

-- Tabla Progreso
CREATE TABLE Progreso 
(
    id_Progreso INT AUTO_INCREMENT PRIMARY KEY,
    fecha_ultimo_acceso DATE,
    lecciones_completadas INT,
    id_Usuario INT,
    id_Modulo INT,
    FOREIGN KEY (id_Usuario) REFERENCES Usuario(id_usuario),
    FOREIGN KEY (id_Modulo) REFERENCES Modulo(id_Modulo)
);

-- Tabla intermedia Modulo_has_Usuario
CREATE TABLE Modulo_has_Usuario 
(
    Modulo_id_Modulo INT,
    Usuario_id_usuario INT,
    PRIMARY KEY (Modulo_id_Modulo, Usuario_id_usuario),
    FOREIGN KEY (Modulo_id_Modulo) REFERENCES Modulo(id_Modulo),
    FOREIGN KEY (Usuario_id_usuario) REFERENCES Usuario(id_usuario)
);

# --- CONFIGURACIÓN DE BASE DE DATOS ---
# Host: Generalmente 'localhost' o IP del servidor MySQL
DB_HOST=localhost

# Name: Nombre de la base de datos (ej: lenguaje_senas)
DB_NAME=lenguaje_senas_db

# User: Usuario de MySQL con permisos de lectura/escritura
DB_USER=root

# Pass: Contraseña del usuario 
DB_PASS=

# Port: Puerto estándar de MySQL (3306)
DB_PORT=3306

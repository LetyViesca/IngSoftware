# --- CONFIGURACIÓN DE BASE DE DATOS (REQUERIDO) ---
# Host: Servidor de BD. En desarrollo usar 'localhost', en producción la IP del servidor.
DB_HOST=localhost

# Name: Nombre de la base de datos (Ej: lenguaje_senas_db). CAMBIO OBLIGATORIO.
DB_NAME=lenguaje_senas_db

# User: Usuario de MySQL. REQUERIDO.
DB_USER=root

# Pass: Contraseña del usuario. CAMPO OBLIGATORIO. 
# (Incluso en local se recomienda configurar una contraseña por seguridad).
DB_PASS=tu_contraseña_aqui

# Port: Puerto de MySQL. Estándar: 3306. REQUERIDO.
DB_PORT=3306

# --- CONFIGURACIÓN DE ENTORNO ---
# APP_ENV: Define si el proyecto está en 'development' o 'production'.
APP_ENV=development
